#!/usr/bin/env python3
"""
vpngw — VPNGate Gateway 命令行工具
用法：
  vpngw                     交互菜单
  vpngw status              查看状态
  vpngw fetch               抓取节点
  vpngw fetch --country JP,US
  vpngw fetch --top 30
  vpngw auto                自动连接最快节点
  vpngw auto JP             自动连接最快日本节点
  vpngw nodes               查看节点列表
  vpngw connect <node_id>   连接指定节点
  vpngw rotate              轮换节点
  vpngw stop                断开并停止
  vpngw logs                查看日志
  vpngw set <key> <value>   修改设置
"""
from __future__ import annotations
import argparse
import json
import os
import shutil
import sys
import time
from pathlib import Path

# ── 路径 ──────────────────────────────────────────────────────────────────────
INSTALL_DIR  = Path("/opt/vpngate-gateway")
DATA_DIR     = INSTALL_DIR / "data"
CMD_FILE     = DATA_DIR / "cmd.json"
CMD_RESULT   = DATA_DIR / "cmd_result.json"
NODES_FILE   = DATA_DIR / "nodes.json"
STATE_FILE   = DATA_DIR / "state.json"
LOG_FILE     = DATA_DIR / "vpngate.log"
SETTINGS_FILE= DATA_DIR / "settings.json"

# ── 颜色 ──────────────────────────────────────────────────────────────────────
_use_color = sys.stdout.isatty()

def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _use_color else text

def red(t: str)    -> str: return _c("0;31", t)
def green(t: str)  -> str: return _c("0;32", t)
def yellow(t: str) -> str: return _c("1;33", t)
def cyan(t: str)   -> str: return _c("0;36", t)
def bold(t: str)   -> str: return _c("1", t)
def dim(t: str)    -> str: return _c("2", t)


# ── 工具 ──────────────────────────────────────────────────────────────────────
def _read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def _write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(path)


def _service_running() -> bool:
    import subprocess
    r = subprocess.run(
        ["systemctl", "is-active", "vpngate-gateway"],
        capture_output=True, text=True
    )
    return r.stdout.strip() == "active"


# ── 命令总线发送 ──────────────────────────────────────────────────────────────
def _send_cmd(cmd: str, args: list = [], timeout: int = 120) -> tuple[bool, str]:
    """
    写命令到 cmd.json，等待 cmd_result.json 更新。
    返回 (ok, message)
    """
    if not DATA_DIR.exists():
        return False, "数据目录不存在，服务可能未安装"

    ts = time.time()
    _write_json(CMD_FILE, {"cmd": cmd, "args": args, "ts": ts})

    deadline = time.time() + timeout
    spinner  = ["|", "/", "-", "\\"]
    i        = 0
    while time.time() < deadline:
        time.sleep(0.3)
        result = _read_json(CMD_RESULT, {})
        if result.get("ts", 0) > ts:
            return result.get("ok", False), result.get("msg", "")
        if sys.stdout.isatty():
            print(f"\r  {spinner[i % len(spinner)]} 等待响应...", end="", flush=True)
            i += 1

    if sys.stdout.isatty():
        print()
    return False, f"命令超时（{timeout}s）"


# ── status ────────────────────────────────────────────────────────────────────
def cmd_status(args) -> None:
    state   = _read_json(STATE_FILE, {})
    nodes   = _read_json(NODES_FILE, [])
    active  = state.get("active_node_id", "")
    message = state.get("message", "")
    running = _service_running()

    print()
    print(bold("─" * 50))
    print(bold("  VPNGate Gateway 状态"))
    print(bold("─" * 50))

    svc_text = green("● 运行中") if running else red("● 已停止")
    print(f"  服务状态  {svc_text}")

    if active:
        node = next((n for n in nodes if n["id"] == active), None)
        if node:
            lat_color = green if node.get("latency_ms", 0) < 100 else yellow
            print(f"  连接节点  {green(active)}")
            print(f"  出口 IP   {cyan(node.get('ip',''))}")
            print(f"  国家      {node.get('country', node.get('country_code',''))}")
            print(f"  延迟      {lat_color(str(node.get('latency_ms','')))} ms")
            print(f"  ISP       {dim(node.get('isp',''))}")
        else:
            print(f"  连接节点  {cyan(active)}")
    else:
        print(f"  连接节点  {yellow('未连接')}")

    if message:
        print(f"  消息      {dim(message)}")

    if state.get("connected_at"):
        dt = time.time() - state["connected_at"]
        h, m = int(dt // 3600), int((dt % 3600) // 60)
        print(f"  连接时长  {h}h {m}m")

    print(f"  节点数量  {len(nodes)} 个")

    # 出口 IP 实时检测
    if "--check" in sys.argv or getattr(args, "check", False):
        print()
        print("  正在检测出口 IP...", end="", flush=True)
        import subprocess
        result = subprocess.run(
            ["curl", "-4", "-s", "--socks5-hostname", "127.0.0.1:7928",
             "https://api.ipify.org", "--max-time", "8"],
            capture_output=True, text=True, timeout=12
        )
        if result.returncode == 0 and result.stdout.strip():
            print(f"\r  出口 IP   {green(result.stdout.strip())}    ")
        else:
            print(f"\r  出口 IP   {red('检测失败（代理不可用）')}    ")

    print(bold("─" * 50))
    print()


# ── fetch ─────────────────────────────────────────────────────────────────────
def cmd_fetch(args) -> None:
    cmd_args = []
    country = getattr(args, "country", None)
    top     = getattr(args, "top", None)
    if country:
        cmd_args.append(country)
    if top:
        cmd_args.append(str(top))

    parts = []
    if country:
        parts.append(f"国家: {country}")
    if top:
        parts.append(f"前 {top} 个")
    desc = "，".join(parts) if parts else "所有节点"
    print(f"\n  正在抓取节点（{desc}）...\n")

    ok, msg = _send_cmd("fetch", cmd_args, timeout=180)
    _print_result(ok, msg)


# ── nodes ─────────────────────────────────────────────────────────────────────
def cmd_nodes(args) -> None:
    nodes = _read_json(NODES_FILE, [])
    if not nodes:
        print(yellow("\n  暂无节点，请先执行 vpngw fetch\n"))
        return

    country_filter = getattr(args, "country", None)
    if country_filter:
        nodes = [n for n in nodes if n.get("country_code") == country_filter.upper()]

    limit = getattr(args, "limit", 30) or 30

    col_w = shutil.get_terminal_size((120, 40)).columns
    short = col_w < 100

    print()
    if short:
        print(bold(f"  {'#':<3} {'国家':<6} {'IP':<15} {'延迟':>6} {'状态':<8}"))
        print("  " + "─" * 44)
    else:
        print(bold(f"  {'#':<3} {'国家':<8} {'IP':<15} {'延迟':>6} {'探测':<8} {'ISP':<28} {'节点ID'}"))
        print("  " + "─" * 90)

    for i, n in enumerate(nodes[:limit], 1):
        active    = n.get("active", False)
        lat       = n.get("latency_ms", 0)
        pstatus   = n.get("probe_status", "not_checked")
        prefix    = green("▶ ") if active else "  "
        lat_str   = (green if lat < 80 else yellow if lat < 200 else red)(f"{lat}ms")
        probe_ico = {"available": green("✔"), "unavailable": red("✘"),
                     "not_checked": dim("?")}.get(pstatus, "?")
        country   = n.get("country") or n.get("country_code", "")

        if short:
            print(f"{prefix}{i:<3} {country:<6} {n['ip']:<15} {lat_str:>6} {probe_ico}")
        else:
            isp = (n.get("isp") or "")[:28]
            nid = n["id"][:35]
            print(f"{prefix}{i:<3} {country:<8} {n['ip']:<15} {lat_str:>6} {probe_ico:<8} {isp:<28} {dim(nid)}")

    if len(nodes) > limit:
        print(f"\n  {dim(f'（共 {len(nodes)} 个，显示前 {limit} 个，用 --limit N 调整）')}")
    print()


# ── auto ──────────────────────────────────────────────────────────────────────
def cmd_auto(args) -> None:
    country = getattr(args, "country", None)
    label   = f"（{country}）" if country else ""
    print(f"\n  正在自动选择最快节点{label}...\n")
    cmd_args = [country] if country else []
    ok, msg  = _send_cmd("auto_connect", cmd_args, timeout=60)
    _print_result(ok, msg)
    if ok:
        cmd_status(args)


# ── connect ───────────────────────────────────────────────────────────────────
def cmd_connect(args) -> None:
    node_id = args.node_id
    print(f"\n  正在连接: {cyan(node_id)}\n")
    ok, msg = _send_cmd("connect", [node_id], timeout=60)
    _print_result(ok, msg)
    if ok:
        cmd_status(args)


# ── rotate ────────────────────────────────────────────────────────────────────
def cmd_rotate(args) -> None:
    print("\n  正在切换节点...\n")
    ok, msg = _send_cmd("rotate", timeout=60)
    _print_result(ok, msg)
    if ok:
        cmd_status(args)


# ── stop ──────────────────────────────────────────────────────────────────────
def cmd_stop(args) -> None:
    ok, msg = _send_cmd("disconnect")
    _print_result(ok, msg)


# ── logs ──────────────────────────────────────────────────────────────────────
def cmd_logs(args) -> None:
    n = getattr(args, "lines", 50) or 50
    if LOG_FILE.exists():
        lines = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
        print()
        for line in lines[-n:]:
            # 简单着色
            if "失败" in line or "错误" in line or "Error" in line:
                print(red(f"  {line}"))
            elif "成功" in line or "已连接" in line or "启动" in line:
                print(green(f"  {line}"))
            elif "警告" in line or "超时" in line:
                print(yellow(f"  {line}"))
            else:
                print(f"  {line}")
        print()
    else:
        print(yellow("\n  日志文件不存在\n"))


# ── set ───────────────────────────────────────────────────────────────────────
_SETTING_HELP = {
    "country_filter": "国家代码列表，逗号分隔（如 JP,US,KR），空字符串=不限",
    "rotate_hours":   "自动轮换间隔（小时），0=关闭",
    "top_nodes":      "保留节点数量（建议 10~50）",
    "proxy_port":     "SOCKS5 代理监听端口（默认 7928）",
    "probe_count":    "OpenVPN 握手验证节点数（越多越慢，建议 5~15）",
    "auto_fetch_on_start": "启动时自动抓取节点（true/false）",
}

def cmd_set(args) -> None:
    key   = args.key
    value = args.value

    settings = _read_json(SETTINGS_FILE, {})
    defaults = {
        "country_filter": [], "rotate_hours": 2, "top_nodes": 20,
        "proxy_port": 7928, "probe_count": 10, "auto_fetch_on_start": True,
    }
    defaults.update(settings)

    if key not in defaults:
        print(red(f"\n  未知设置项: {key}"))
        print(f"\n  可用设置项：")
        for k, h in _SETTING_HELP.items():
            print(f"    {cyan(k):<30} {h}")
        print()
        return

    # 类型转换
    old_val = defaults[key]
    try:
        if isinstance(old_val, list):
            new_val = [x.strip().upper() for x in value.split(",") if x.strip()] if value else []
        elif isinstance(old_val, bool):
            new_val = value.lower() in ("true", "1", "yes")
        elif isinstance(old_val, int):
            new_val = int(value)
        elif isinstance(old_val, float):
            new_val = float(value)
        else:
            new_val = value
    except ValueError:
        print(red(f"\n  值类型错误: 期望 {type(old_val).__name__}\n"))
        return

    defaults[key] = new_val
    _write_json(SETTINGS_FILE, defaults)
    print(green(f"\n  已保存: {key} = {new_val}\n"))
    print(dim(f"  提示: 部分设置需要重启服务生效（systemctl restart vpngate-gateway）\n"))


# ── 交互菜单 ──────────────────────────────────────────────────────────────────
def cmd_menu(_args=None) -> None:
    import subprocess as sp
    while True:
        os.system("clear" if os.name == "posix" else "cls")
        print(cyan("""
 ╔══════════════════════════════════════════════╗
 ║         VPNGate Gateway 管理菜单             ║
 ╠══════════════════════════════════════════════╣
 ║  1. 查看状态（含出口 IP 检测）               ║
 ║  2. 抓取节点                                 ║
 ║  3. 查看节点列表                             ║
 ║  4. 自动连接最快节点                         ║
 ║  5. 按国家连接                               ║
 ║  6. 轮换节点                                 ║
 ║  7. 手动选择节点                             ║
 ║  8. 断开连接                                 ║
 ║  9. 查看日志                                 ║
 ║  0. 修改设置                                 ║
 ║  q. 退出                                     ║
 ╚══════════════════════════════════════════════╝"""))
        print()
        choice = input("  请选择 [0-9/q]: ").strip().lower()

        class FakeArgs:
            check  = True
            limit  = 30
            lines  = 50
            country = None

        fa = FakeArgs()

        if choice == "1":
            fa.check = True
            cmd_status(fa)
            input("  按 Enter 继续...")
        elif choice == "2":
            fa.country = input("  国家代码（留空=全部，如 JP,US）: ").strip() or None
            top_s = input("  保留节点数（留空=默认）: ").strip()
            fa.top = int(top_s) if top_s.isdigit() else None
            cmd_fetch(fa)
            input("  按 Enter 继续...")
        elif choice == "3":
            fa.country = input("  过滤国家（留空=全部）: ").strip() or None
            limit_s = input("  显示数量（留空=30）: ").strip()
            fa.limit = int(limit_s) if limit_s.isdigit() else 30
            cmd_nodes(fa)
            input("  按 Enter 继续...")
        elif choice == "4":
            cmd_auto(fa)
            input("  按 Enter 继续...")
        elif choice == "5":
            fa.country = input("  国家代码（如 JP）: ").strip().upper() or None
            cmd_auto(fa)
            input("  按 Enter 继续...")
        elif choice == "6":
            cmd_rotate(fa)
            input("  按 Enter 继续...")
        elif choice == "7":
            _menu_manual_connect()
            input("  按 Enter 继续...")
        elif choice == "8":
            cmd_stop(fa)
            input("  按 Enter 继续...")
        elif choice == "9":
            lines_s = input("  显示行数（留空=50）: ").strip()
            fa.lines = int(lines_s) if lines_s.isdigit() else 50
            cmd_logs(fa)
            input("  按 Enter 继续...")
        elif choice == "0":
            _menu_settings()
        elif choice in ("q", "quit", "exit"):
            print()
            break


def _menu_manual_connect() -> None:
    nodes = _read_json(NODES_FILE, [])
    if not nodes:
        print(yellow("  暂无节点，请先抓取"))
        return

    print()
    for i, n in enumerate(nodes[:20], 1):
        active = green("▶") if n.get("active") else " "
        lat    = n.get("latency_ms", 0)
        lat_s  = (green if lat < 100 else yellow)(f"{lat}ms")
        print(f"  {active}{i:>2}. [{n.get('country_code','??')}] {n['ip']:<15} {lat_s:>6}  {n.get('country','')}")
    print()
    sel = input("  选择序号（留空=取消）: ").strip()
    if sel.isdigit():
        idx = int(sel) - 1
        if 0 <= idx < min(20, len(nodes)):
            node_id = nodes[idx]["id"]
            print(f"\n  正在连接: {node_id}")
            ok, msg = _send_cmd("connect", [node_id], timeout=60)
            _print_result(ok, msg)


def _menu_settings() -> None:
    settings = _read_json(SETTINGS_FILE, {})
    print()
    print(bold("  当前设置："))
    for k, h in _SETTING_HELP.items():
        val = settings.get(k, "（默认）")
        print(f"  {cyan(k):<30} = {yellow(str(val))}")
        print(f"  {' ' * 30}   {dim(h)}")
    print()
    key = input("  要修改的设置项（留空=返回）: ").strip()
    if not key:
        return
    val = input(f"  新值: ").strip()

    class FakeArgs:
        pass
    fa = FakeArgs()
    fa.key, fa.value = key, val
    cmd_set(fa)


# ── 工具函数 ──────────────────────────────────────────────────────────────────
def _print_result(ok: bool, msg: str) -> None:
    print()
    if ok:
        print(f"  {green('✔')} {msg}")
    else:
        print(f"  {red('✘')} {msg}")
    print()


# ── 主入口 ────────────────────────────────────────────────────────────────────
def main() -> None:
    parser = argparse.ArgumentParser(
        prog="vpngw",
        description="VPNGate Gateway 命令行管理工具",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="subcmd")

    # status
    p_status = sub.add_parser("status", help="查看状态")
    p_status.add_argument("--check", action="store_true", help="实时检测出口 IP")
    p_status.set_defaults(func=cmd_status)

    # fetch
    p_fetch = sub.add_parser("fetch", help="抓取节点")
    p_fetch.add_argument("--country", metavar="JP,US", help="国家代码（逗号分隔）")
    p_fetch.add_argument("--top", type=int, metavar="N", help="保留前 N 个节点")
    p_fetch.set_defaults(func=cmd_fetch)

    # nodes
    p_nodes = sub.add_parser("nodes", help="查看节点列表")
    p_nodes.add_argument("--country", metavar="JP", help="过滤国家")
    p_nodes.add_argument("--limit", type=int, default=30, metavar="N")
    p_nodes.set_defaults(func=cmd_nodes)

    # auto
    p_auto = sub.add_parser("auto", help="自动连接最快节点")
    p_auto.add_argument("country", nargs="?", help="国家代码（可选）")
    p_auto.set_defaults(func=cmd_auto)

    # connect
    p_conn = sub.add_parser("connect", help="连接指定节点")
    p_conn.add_argument("node_id", help="节点 ID（从 nodes 列表获取）")
    p_conn.set_defaults(func=cmd_connect)

    # rotate
    p_rot = sub.add_parser("rotate", help="切换到下一个节点")
    p_rot.set_defaults(func=cmd_rotate)

    # stop
    p_stop = sub.add_parser("stop", help="断开连接")
    p_stop.set_defaults(func=cmd_stop)

    # logs
    p_logs = sub.add_parser("logs", help="查看日志")
    p_logs.add_argument("-n", "--lines", type=int, default=50, metavar="N")
    p_logs.set_defaults(func=cmd_logs)

    # set
    p_set = sub.add_parser("set", help="修改设置")
    p_set.add_argument("key", help="设置项名称")
    p_set.add_argument("value", help="新值")
    p_set.set_defaults(func=cmd_set)

    # 无子命令 → 交互菜单
    args = parser.parse_args()
    if args.subcmd is None:
        cmd_menu()
    else:
        args.func(args)


if __name__ == "__main__":
    main()
