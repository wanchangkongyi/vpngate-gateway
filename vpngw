# ── stop ──────────────────────────────────────────────────────────────────────
def cmd_stop(args=None, pause=False):
    ok, msg = _send_cmd("disconnect")
    _print_result(ok, msg)
    if pause: input("  按 Enter 继续...")

# ── logs ──────────────────────────────────────────────────────────────────────
def cmd_logs(args=None, pause=False):
    n = getattr(args, "lines", 50) if args else 50
    if LOG_FILE.exists():
        lines = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
        print()
        for line in lines[-n:]:
            if any(k in line for k in ["失败","错误","Error"]):   print(red(f"  {line}"))
            elif any(k in line for k in ["成功","已连接","启动"]): print(green(f"  {line}"))
            elif any(k in line for k in ["警告","超时"]):          print(yellow(f"  {line}"))
            else:                                                   print(f"  {line}")
        print()
    else:
        print(yellow("\n  日志文件不存在\n"))
    if pause: input("  按 Enter 继续...")

# ── 服务管理 ──────────────────────────────────────────────────────────────────
def cmd_service(args=None, pause=False):
    action = getattr(args, "action", None) if args else None
    if not action:
        print()
        print(bold("  服务管理"))
        print("  1. 重启服务")
        print("  2. 停止服务")
        print("  3. 启动服务")
        print("  4. 快捷重装（不卸载依赖）")
        print("  0. 返回")
        print()
        choice = input("  选择: ").strip()
        if choice == "0" or not choice:
            return
        elif choice == "1": action = "restart"
        elif choice == "2": action = "stop"
        elif choice == "3": action = "start"
        elif choice == "4":
            _reinstall()
            if pause: input("  按 Enter 继续...")
            return
        else:
            print(red("  无效选择"))
            if pause: input("  按 Enter 继续...")
            return

    action_name = {"restart":"重启","stop":"停止","start":"启动"}.get(action, action)
    print(f"\n  正在{action_name}服务...\n")
    r = subprocess.run(["systemctl", action, "vpngate-gateway"], capture_output=True, text=True)
    if r.returncode == 0:
        time.sleep(2)
        _print_result(True, f"服务已{action_name}")
        print(f"  当前状态: {green('运行中') if _service_running() else red('已停止')}\n")
    else:
        _print_result(False, r.stderr.strip() or "操作失败")
    if pause: input("  按 Enter 继续...")

def _reinstall():
    print("\n  正在重装（保留依赖和数据）...\n")
    # 停止服务
    subprocess.run(["systemctl","stop","vpngate-gateway"], capture_output=True)
    # 重新下载核心文件
    files = ["vpn_utils.py","proxy_server.py","vpngate_manager.py","vpngw"]
    ok_all = True
    for f in files:
        print(f"  下载 {f}...", end="", flush=True)
        r = subprocess.run(
            ["curl","-fsSL",f"{GITHUB_RAW}/{f}","-o",str(INSTALL_DIR/f)],
            capture_output=True, text=True
        )
        if r.returncode == 0:
            print(green(" ✔"))
        else:
            print(red(" ✘"))
            ok_all = False
    if ok_all:
        subprocess.run(["chmod","+x",str(INSTALL_DIR/"vpngw")], capture_output=True)
        subprocess.run(["ln","-sf",str(INSTALL_DIR/"vpngw"),"/usr/local/bin/vpngw"], capture_output=True)
        subprocess.run(["ln","-sf",str(INSTALL_DIR/"vpngw"),"/usr/local/bin/vg"], capture_output=True)
        subprocess.run(["systemctl","start","vpngate-gateway"], capture_output=True)
        time.sleep(2)
        _print_result(True, f"重装完成，服务{'已启动' if _service_running() else '启动失败'}")
    else:
        _print_result(False, "部分文件下载失败，请检查网络")
        subprocess.run(["systemctl","start","vpngate-gateway"], capture_output=True)

# ── 卸载 ──────────────────────────────────────────────────────────────────────
def cmd_uninstall(args=None, pause=False):
    print()
    print(bold("  卸载选项"))
    print("  1. 卸载服务（保留依赖，重新安装无需重装依赖）")
    print("  2. 彻底卸载（含 openvpn/iproute2 等依赖）")
    print("  0. 取消")
    print()
    choice = input("  选择: ").strip()
    if choice == "0": return
    if choice not in ("1","2"):
        print(red("  无效选择")); return

    if input(f"\n  确认{'卸载服务' if choice=='1' else '彻底卸载'}？[y/N] ").strip().lower() != "y":
        print("  已取消"); return

    subprocess.run(["systemctl","stop","vpngate-gateway"], capture_output=True)
    subprocess.run(["systemctl","disable","vpngate-gateway"], capture_output=True)
    subprocess.run(["pkill","-f","openvpn.*vpngate-gateway"], capture_output=True)

    import shutil as _sh
    for f in ["/etc/systemd/system/vpngate-gateway.service",
              "/lib/systemd/system/vpngate-gateway.service"]:
        try: os.unlink(f)
        except: pass
    subprocess.run(["systemctl","daemon-reload"], capture_output=True)
    for f in ["/usr/local/bin/vpngw","/usr/local/bin/vg"]:
        try: os.unlink(f)
        except: pass
    try:
        _sh.rmtree(str(INSTALL_DIR))
        print(green("  ✔ 安装目录已删除"))
    except Exception as e:
        print(red(f"  ✘ 删除安装目录失败: {e}"))

    if choice == "2":
        r = subprocess.run(["apt-get","remove","-y","--auto-remove","openvpn","iproute2","net-tools"],
                           capture_output=True, text=True)
        print(green("  ✔ 依赖已卸载") if r.returncode==0 else yellow("  ⚠ 依赖卸载部分失败"))

    print(green("\n  ✔ 卸载完成\n"))

# ── 设置 ──────────────────────────────────────────────────────────────────────
SETTINGS_DEF = [
    ("country_filter",       "国家过滤",       "逗号分隔的国家代码，如 JP,US,KR，空=不限",  "list"),
    ("rotate_hours",         "自动轮换间隔",   "小时，0=关闭",                              "float"),
    ("latency_check_hours",  "延迟检测间隔",   "小时，0=关闭定时检测",                      "float"),
    ("min_nodes",            "最低节点数",     "节点数低于此值时自动重新抓取",               "int"),
    ("top_nodes",            "保留节点数",     "抓取后保留前N个节点",                        "int"),
    ("probe_count",          "握手验证数",     "OpenVPN握手验证节点数，0=跳过",              "int"),
    ("proxy_port",           "代理端口",       "SOCKS5/HTTP代理监听端口",                    "int"),
    ("auto_fetch_on_start",  "启动自动抓取",   "服务启动时自动抓取节点 true/false",          "bool"),
    ("outlet_check_interval", "出口检测间隔",   "秒，0=关闭出口连通性检测",                   "int"),
    ("outlet_max_fails",      "出口失败阈值",   "连续失败N次后标记节点不可用并轮换",           "int"),
]

def cmd_set(args=None, pause=False):
    settings = _read_json(SETTINGS_FILE, {})
    defaults = {"country_filter":[],"rotate_hours":2,"latency_check_hours":1,"min_nodes":5,
                "top_nodes":20,"probe_count":10,"proxy_port":7928,"auto_fetch_on_start":True,
                "outlet_check_interval":60,"outlet_max_fails":3}
    defaults.update(settings)

    key   = getattr(args, "key", None) if args else None
    value = getattr(args, "value", None) if args else None

    if not key:
        print()
        print(bold("  当前设置（输入序号修改）："))
        print()
        for i, (k, name, desc, typ) in enumerate(SETTINGS_DEF, 1):
            print(f"  {cyan(str(i))}. {bold(name):<14} = {yellow(str(defaults.get(k,'')))}")
            print(f"     {dim(desc)}")
            print()
        print(f"  {cyan('0')}. 返回")
        print()
        sel = input("  选择序号: ").strip()
        if sel == "0" or not sel: return
        if sel.isdigit() and 1 <= int(sel) <= len(SETTINGS_DEF):
            k, name, desc, typ = SETTINGS_DEF[int(sel)-1]
            key = k
            print(f"\n  当前值: {yellow(str(defaults.get(k,'')))}  {dim(desc)}")
            value = input(f"  新值: ").strip()
        else:
            print(red("  无效选择"))
            if pause: input("  按 Enter 继续...")
            return

    entry = next((e for e in SETTINGS_DEF if e[0] == key), None)
    if not entry:
        print(red(f"\n  未知设置项: {key}\n"))
        if pause: input("  按 Enter 继续...")
        return

    _, name, _, typ = entry
    try:
        if   typ == "list":  new_val = [x.strip().upper() for x in value.split(",") if x.strip()] if value else []
        elif typ == "bool":  new_val = value.lower() in ("true","1","yes")
        elif typ == "int":   new_val = int(value)
        elif typ == "float": new_val = float(value)
        else:                new_val = value
    except ValueError:
        print(red(f"\n  值格式错误\n"))
        if pause: input("  按 Enter 继续...")
        return

    defaults[key] = new_val
    _write_json(SETTINGS_FILE, defaults)
    print(green(f"\n  ✔ {name} 已设置为: {new_val}"))
    print(dim("  部分设置需重启服务生效: systemctl restart vpngate-gateway\n"))
    if pause: input("  按 Enter 继续...")

# ── 交互菜单 ──────────────────────────────────────────────────────────────────
