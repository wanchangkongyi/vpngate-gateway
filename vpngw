#!/usr/bin/env python3
"""vg / vpngw — VPNGate Gateway 命令行工具"""
from __future__ import annotations
import argparse, json, os, shutil, subprocess, sys, time
from pathlib import Path

INSTALL_DIR   = Path("/opt/vpngate-gateway")
DATA_DIR      = INSTALL_DIR / "data"
CMD_FILE      = DATA_DIR / "cmd.json"
CMD_RESULT    = DATA_DIR / "cmd_result.json"
NODES_FILE    = DATA_DIR / "nodes.json"
STATE_FILE    = DATA_DIR / "state.json"
LOG_FILE      = DATA_DIR / "vpngate.log"
SETTINGS_FILE = DATA_DIR / "settings.json"
GITHUB_RAW    = "https://raw.githubusercontent.com/wanchangkongyi/vpngate-gateway/main"
INSTALL_SH    = "https://raw.githubusercontent.com/wanchangkongyi/vpngate-gateway/main/install.sh"

_tty = sys.stdout.isatty()
def _c(code, t): return f"\033[{code}m{t}\033[0m" if _tty else t
def red(t):    return _c("0;31", t)
def green(t):  return _c("0;32", t)
def yellow(t): return _c("1;33", t)
def cyan(t):   return _c("0;36", t)
def bold(t):   return _c("1", t)
def dim(t):    return _c("2", t)

def _read_json(path, default=None):
    try: return json.loads(path.read_text(encoding="utf-8"))
    except: return default

def _write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(path)

def _service_running():
    r = subprocess.run(["systemctl","is-active","vpngate-gateway"], capture_output=True, text=True)
    return r.stdout.strip() == "active"

def _send_cmd(cmd, args=[], timeout=120):
    if not DATA_DIR.exists():
        return False, "数据目录不存在"
    ts = time.time()
    _write_json(CMD_FILE, {"cmd": cmd, "args": args, "ts": ts})
    spinner = ["|","/","-","\\"]
    i = 0
    while time.time() < ts + timeout:
        time.sleep(0.3)
        r = _read_json(CMD_RESULT, {})
        if r.get("ts", 0) > ts:
            if _tty: print("\r" + " "*30 + "\r", end="", flush=True)
            return r.get("ok", False), r.get("msg", "")
        if _tty:
            print(f"\r  {spinner[i%4]} 等待响应...", end="", flush=True)
            i += 1
    if _tty: print()
    return False, f"命令超时（{timeout}s）"

def _print_result(ok, msg):
    print()
    print(f"  {green('✔') if ok else red('✘')} {msg}")
    print()

# ── status ────────────────────────────────────────────────────────────────────
def cmd_status(args=None, pause=False):
    state   = _read_json(STATE_FILE, {})
    nodes   = _read_json(NODES_FILE, [])
    active  = state.get("active_node_id", "")
    running = _service_running()
    s       = _read_json(SETTINGS_FILE, {})
    port    = s.get("proxy_port", 7928)

    print()
    print(bold("─" * 52))
    print(bold("  VPNGate Gateway 状态"))
    print(bold("─" * 52))
    print(f"  服务状态  {green('● 运行中') if running else red('● 已停止')}")

    if active:
        node = next((n for n in nodes if n["id"] == active), None)
        if node:
            lat = node.get("latency_ms", 0)
            print(f"  连接节点  {green(active)}")
            print(f"  节点 IP   {cyan(node.get('ip',''))}")
            print(f"  国家      {node.get('country', node.get('country_code',''))}")
            print(f"  延迟      {(green if lat<100 else yellow)(str(lat))} ms")
            if node.get("isp"):
                print(f"  ISP       {dim(node.get('isp',''))}")
    else:
        print(f"  连接节点  {yellow('未连接')}")

    if state.get("message"):
        print(f"  消息      {dim(state['message'])}")
    if state.get("connected_at"):
        dt = time.time() - state["connected_at"]
        print(f"  连接时长  {int(dt//3600)}h {int((dt%3600)//60)}m")

    print(f"  代理端口  {cyan(str(port))}")
    print(f"  节点数量  {len(nodes)} 个")

    check = getattr(args, "check", False) if args else False
    if check or pause:
        print()
        print(f"  检测出口 IP...", end="", flush=True)
        ip = ""
        for cmd in [
            ["curl","-4","-s","--proxy",f"socks5h://127.0.0.1:{port}","https://api.ipify.org","--max-time","8"],
            ["curl","-4","-s","--socks5-hostname",f"127.0.0.1:{port}","https://api.ipify.org","--max-time","8"],
        ]:
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=12)
                if r.returncode == 0 and r.stdout.strip():
                    ip = r.stdout.strip(); break
            except: continue
        if ip: print(f"\r  出口 IP   {green(ip)}          ")
        else:  print(f"\r  出口 IP   {red('检测失败')}            ")

    print(bold("─" * 52))
    print()
    if pause: input("  按 Enter 继续...")

# ── fetch ─────────────────────────────────────────────────────────────────────
def cmd_fetch(args=None, pause=False):
    country = getattr(args, "country", None) if args else None
    top     = getattr(args, "top", None) if args else None
    cmd_args = []
    if country: cmd_args.append(country)
    if top:     cmd_args.append(str(top))
    desc = f"{'国家:'+country+' ' if country else ''}{'前'+str(top)+'个' if top else ''}"
    print(f"\n  正在抓取节点{'（'+desc+'）' if desc else ''}...\n")
    ok, msg = _send_cmd("fetch", cmd_args, timeout=180)
    _print_result(ok, msg)
    if ok: cmd_status(pause=False)
    if pause: input("  按 Enter 继续...")

# ── check_latency ─────────────────────────────────────────────────────────────
def cmd_check_latency(args=None, pause=False):
    print("\n  正在检测所有节点延迟...\n")
    ok, msg = _send_cmd("check_latency", timeout=120)
    _print_result(ok, msg)
    if ok: cmd_nodes(pause=False)
    if pause: input("  按 Enter 继续...")

# ── nodes ─────────────────────────────────────────────────────────────────────
def cmd_nodes(args=None, pause=False):
    nodes = _read_json(NODES_FILE, [])
    if not nodes:
        print(yellow("\n  暂无节点，请先执行 vg fetch\n"))
        if pause: input("  按 Enter 继续...")
        return

    country = getattr(args, "country", None) if args else None
    if country:
        nodes = [n for n in nodes if n.get("country_code") == country.upper()]
    limit = getattr(args, "limit", 30) if args else 30
    short = shutil.get_terminal_size((120,40)).columns < 100

    print()
    if short:
        print(bold(f"  {'#':<3} {'国家':<6} {'IP':<15} {'延迟':>6} {'探测':<4}"))
        print("  " + "─"*38)
    else:
        print(bold(f"  {'#':<3} {'国家':<8} {'IP':<15} {'延迟':>6} {'探测':<4} {'ISP':<28} {'节点ID'}"))
        print("  " + "─"*88)

    for i, n in enumerate(nodes[:limit], 1):
        prefix  = green("▶ ") if n.get("active") else "  "
        lat     = n.get("latency_ms", 0)
        lat_s   = (green if lat<80 else yellow if lat<200 else red)(f"{lat}ms")
        probe   = {"available":green("✔"),"unavailable":red("✘"),"not_checked":dim("?")}.get(n.get("probe_status","not_checked"),"?")
        country_name = n.get("country") or n.get("country_code","")
        if short:
            print(f"{prefix}{i:<3} {country_name:<6} {n['ip']:<15} {lat_s:>6} {probe}")
        else:
            print(f"{prefix}{i:<3} {country_name:<8} {n['ip']:<15} {lat_s:>6} {probe:<4} {(n.get('isp') or '')[:28]:<28} {dim(n['id'][:35])}")

    if len(nodes) > limit:
        print(f"\n  {dim(f'共 {len(nodes)} 个，显示前 {limit} 个')}")
    print()
    if pause: input("  按 Enter 继续...")

# ── auto ──────────────────────────────────────────────────────────────────────
def cmd_auto(args=None, pause=False):
    country = getattr(args, "country", None) if args else None
    print(f"\n  正在自动选择最快节点{'（'+country+'）' if country else ''}...\n")
    ok, msg = _send_cmd("auto_connect", [country] if country else [], timeout=60)
    _print_result(ok, msg)
    if ok: cmd_status(pause=False)
    if pause: input("  按 Enter 继续...")

